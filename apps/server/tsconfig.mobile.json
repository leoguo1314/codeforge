{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node"],
    "paths": {
      "@codeforge/contracts": ["../../packages/contracts/src/index.ts"],
      "@codeforge/contracts/*": ["../../packages/contracts/src/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/mobile/Services/**/*.ts",
    "src/mobile/Layers/**/*.ts",
    "src/persistence/Migrations/021_MobilePushDevices.ts",
    "src/persistence/Migrations/022_MobilePushOutbox.ts",
    "src/persistence/Migrations/023_MobilePairingSessions.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
